{
  "name": "demo",
  "version": "1.0.0",
  "description": "Demo CLI application following devalbo-core principles",
  "main": "dist/cli.js",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build": "vite build && vite build --mode node",
    "build:web": "vite build",
    "build:cli": "vite build --mode node",
    "dev": "vite",
    "dev:host": "vite --host",
    "preview": "vite preview",
    "cli": "node dist/cli.js",
    "type-check": "tsc --noEmit"
  },
  "bin": {
    "demo": "./dist/cli.js"
  },
  "keywords": [
    "cli",
    "demo",
    "devalbo-core"
  ],
  "author": "",
